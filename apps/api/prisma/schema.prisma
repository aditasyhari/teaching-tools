generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  googleId       String?         @unique
  name           String
  avatarUrl      String?
  role           UserRole        @default(TEACHER)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  teacherProfile   TeacherProfile?
  classrooms       Classroom[]
  sessions         AuthSession[]
  notes            TeacherNote[]
  teachingSessions Session[]
  quizzes          Quiz[]
  polls            Poll[]

  @@index([email])
  @@index([googleId])
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  schoolName  String?
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Classroom {
  id        String          @id @default(cuid())
  teacherId String
  name      String
  subject   String?
  grade     String?
  status    ClassroomStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  teacher          User              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members          ClassroomMember[]
  notes            TeacherNote[]
  teachingSessions Session[]

  @@index([teacherId])
}

model ClassroomMember {
  id                String       @id @default(cuid())
  classroomId       String
  displayName       String
  studentIdentifier String?
  status            MemberStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  classroom         Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

model AuthSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
}

model TeacherNote {
  id          String     @id @default(cuid())
  teacherId   String
  classroomId String?
  title       String
  content     String     @db.Text
  tags        String[]   @default([])
  pinned      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teacher     User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([classroomId])
  @@index([pinned])
  @@index([createdAt])
}

enum SessionStatus {
  WAITING
  ACTIVE
  ENDED
}

model Session {
  id          String        @id @default(cuid())
  teacherId   String
  classroomId String?
  title       String
  joinCode    String
  status      SessionStatus @default(WAITING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom   Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([joinCode])
  @@index([status])
  @@index([createdAt])
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

model Quiz {
  id          String         @id @default(cuid())
  teacherId   String
  title       String
  description String?
  settings    Json           @default("{}")
  status      QuizStatus     @default(PUBLISHED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  teacher     User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]

  @@index([teacherId])
  @@index([createdAt])
}

model QuizQuestion {
  id               String       @id @default(cuid())
  quizId           String
  order            Int
  questionText     String
  points           Int          @default(100)
  timeLimitSeconds Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options          QuizOption[]

  @@index([quizId])
  @@index([order])
}

model QuizOption {
  id           String       @id @default(cuid())
  questionId   String
  order        Int
  optionText   String
  isCorrect    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([order])
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum PollStatus {
  DRAFT
  PUBLISHED
}

model Poll {
  id          String        @id @default(cuid())
  teacherId   String
  title       String
  question    String        @db.Text
  type        PollType      @default(SINGLE_CHOICE)
  settings    Json          @default("{}")
  status      PollStatus    @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  options     PollOption[]

  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
}

model PollOption {
  id          String        @id @default(cuid())
  pollId      String
  order       Int
  optionText  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  poll        Poll          @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@index([order])
}


