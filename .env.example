# ==============================================================================
# WaliKelas Teaching Tools V1 — Environment Variables Example
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Application Ports (non-default ports as required)
WEB_PORT=3006
API_PORT=4006

# Node Environment
NODE_ENV=development

# Web App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3006
NEXT_PUBLIC_API_URL=http://localhost:4006/api/v1

# API Configuration
API_BASE_URL=http://localhost:4006
CORS_ALLOWED_ORIGINS=http://localhost:3006

# Google OAuth / OIDC (Foundation placeholders for Phase 2)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4006/api/v1/auth/google/callback

# Database (PostgreSQL - Foundation placeholder for Phase 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walikelas_tools?schema=public

# Session / JWT Secret (Phase 2 placeholder)
SESSION_SECRET=replace-this-with-a-secure-random-secret-in-production

