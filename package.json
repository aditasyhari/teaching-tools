{
  "name": "walikelas-teaching-tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"blue,green\" \"pnpm --filter @walikelas/web dev\" \"pnpm --filter @walikelas/api dev\"",
    "dev:web": "pnpm --filter @walikelas/web dev",
    "dev:api": "pnpm --filter @walikelas/api dev",
    "dev:mobile": "pnpm --filter @walikelas/mobile start",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r run clean",
    "db:seed": "pnpm --filter @walikelas/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
